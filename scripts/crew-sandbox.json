{
  "filesystem": {
    "allowWrite": [
      "~/.cargo/advisory-db",
      "~/Library/Developer/CoreSimulator",
      "~/Library/Logs/CoreSimulator",
      "~/Library/Caches/org.swift.swiftpm",
      "~/Library/org.swift.swiftpm",
      "~/.xcodegen",
      "/private/tmp/intrada-ios-test.lock",
      "/private/tmp/intrada-ios-sim-template.lock",
      "/private/tmp/ios-build.log"
    ],
    "denyWrite": [
      "./.githooks",
      "./.mcp.json"
    ]
  },
  "network": {
    "allowMachLookup": [
      "com.apple.CoreSimulator.CoreSimulatorService",
      "com.apple.CoreSimulator.simdiskimaged",
      "com.apple.CoreSimulator.SimLaunchHost-arm64",
      "com.apple.CoreSimulator.SimulatorTrampoline",
      "com.apple.testmanagerd"
    ],
    "allowedDomains": [
      "codeload.github.com",
      "objects.githubusercontent.com",
      "release-assets.githubusercontent.com"
    ]
  }
}
