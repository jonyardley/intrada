<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later; keep in step with backup_rules.xml (#2433). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="intrada.sqlite" />
        <include domain="database" path="intrada.sqlite-journal" />
        <include domain="sharedpref" path="intrada.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="intrada.sqlite" />
        <include domain="database" path="intrada.sqlite-journal" />
        <include domain="sharedpref" path="intrada.xml" />
    </device-transfer>
</data-extraction-rules>
