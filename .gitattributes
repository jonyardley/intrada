# Snapshot-test reference images: binary, never line-merged or diffed as text.
# (See `.claude/rules/ios-quality.md` for how we keep these from bloating
# git history — they're re-recorded on every intentional UI change.)
ios/IntradaTests/__Snapshots__/**/*.png binary

# Claude Design exports and their bundled runtime are mockups, not source:
# keep them out of GitHub's language bar.
design/** linguist-documentation
specs/*/design/** linguist-documentation

# Every branch adds lessons to the end of these logs, so two open at once
# always conflict there. Union keeps both sides' lines; the lessons check
# catches a merge that goes over the cap or keeps a lesson twice (#2937).
docs/lessons.md merge=union
docs/lessons-archive.md merge=union
