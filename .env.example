# intrada local development environment
# Copy this file to .env and fill in your Turso credentials:
#   cp .env.example .env

# Turso database credentials (required for API server)
TURSO_DATABASE_URL=libsql://intrada-YOUR_ORG.turso.io
TURSO_AUTH_TOKEN=your-token-here

# API server port (default: 3001, Fly.io sets 8080 in production)
PORT=3001

# CORS allowed origins, comma-separated. The native app doesn't send an
# Origin header; this only matters for browser-based tools hitting the API.
ALLOWED_ORIGIN=http://localhost:8080

# API base URL baked into the native iOS build (default: https://intrada-api.fly.dev)
INTRADA_API_URL=

# Sentry APM/error reporting (optional — unset = disabled)
# - SENTRY_DSN: API server, read at runtime by intrada-api
# - SENTRY_DSN_NATIVE: native iOS app, written into the built Info.plist by
#   xcodegen (see CLAUDE.md "Environment Variables")
# SENTRY_DSN=
# SENTRY_DSN_NATIVE=
